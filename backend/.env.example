PORT=5000
NODE_ENV=development

# Frontend URL(s) — comma-separated for CORS
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crusoetech?retryWrites=true&w=majority

# JWT — use a long random string (32+ chars)
JWT_SECRET=use_a_long_random_string_at_least_32_characters

# Gmail SMTP (App Password required — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
