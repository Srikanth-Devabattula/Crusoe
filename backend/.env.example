PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/crusoetech

# MongoDB Atlas (replace user, password, cluster; URL-encode special chars in password)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crusoetech?retryWrites=true&w=majority

JWT_SECRET=use_a_long_random_string_at_least_32_characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
