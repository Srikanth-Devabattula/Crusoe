PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crusoetech?retryWrites=true&w=majority

JWT_SECRET=use_a_long_random_string_at_least_32_characters

# Optional — only needed if you send emails from the API (contact forms, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
