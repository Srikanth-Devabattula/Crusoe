PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:3000

# MySQL (Prisma) — GoDaddy example (URL-encode special characters in the password)
DATABASE_URL="mysql://crusoetech_user:YOUR_PASSWORD@166.62.10.46:3306/crusoetech"

# Optional — only for scripts/migrate-mongo-to-mysql.js (not used at runtime)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crusoetech?retryWrites=true&w=majority

JWT_SECRET=use-a-32-plus-character-secret-here-minimum

# Administrator email — only this address can use /admin/login (password is set via Forgot password + OTP)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator

# --- Email (OTP / notifications / form notify) ---
# Option A (recommended on Render): Resend — https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=Crusoe Technologies <onboarding@resend.dev>

# Option B: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
NOTIFY_EMAIL=your_inbox@gmail.com
