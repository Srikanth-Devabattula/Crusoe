PORT=5000
NODE_ENV=development

# Comma-separated frontend origins (localhost is always allowed for dev)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crusoetech?retryWrites=true&w=majority

JWT_SECRET=use_a_long_random_string_at_least_32_characters

# SMTP — required locally and in production (OTP emails)
# Gmail example (use an App Password: https://myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
