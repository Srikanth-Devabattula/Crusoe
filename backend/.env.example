PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crusoetech?retryWrites=true&w=majority

JWT_SECRET=use_a_long_random_string_at_least_32_characters

# Gmail / SMTP (required for OTP login)
# Use a Google App Password (16 chars, no spaces): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your16charapppassword
# Optional display name — on Render use plain email if this causes issues:
# SMTP_FROM=your_email@gmail.com

# Render production: add the same keys in Dashboard → Environment (not only local .env)
# If OTP hangs ~30s then fails, try SMTP_PORT=465 and SMTP_SECURE=true
