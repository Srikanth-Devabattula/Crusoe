PORT=5000
NODE_ENV=development

# Comma-separated allowed frontend origins (local + deployed)
CLIENT_URL=http://localhost:3000,https://your-frontend-domain.com

# Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/crusoetech

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crusoetech?retryWrites=true&w=majority

JWT_SECRET=use_a_long_random_string_at_least_32_characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
