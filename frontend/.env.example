# Use the SAME host for API and uploaded images (blog/news covers).
# Copy this file to .env.local — see ../docs/LOCAL_DEVELOPMENT.md

# Local full-stack (recommended while coding):
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Frontend-only UI work against production API (use with care):
# NEXT_PUBLIC_API_URL=https://backend.crusoetec.com/api
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production build:
# NEXT_PUBLIC_API_URL=https://backend.crusoetec.com/api
# NEXT_PUBLIC_SITE_URL=https://crusoetec.com

# Google Search Console — HTML tag method (content value only, not the full meta tag)
# GOOGLE_SITE_VERIFICATION=your_token_from_search_console
